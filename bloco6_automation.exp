#!/usr/bin/expect -f
set timeout -1

puts "=== 6A: Testando conexão e contando na Hostinger ==="
spawn ssh -p 65002 -o StrictHostKeyChecking=no u176367625@46.202.186.144 "mysql -u u176367625_cpagendakt -p'u5RjUpN\$4/rX' u176367625_CPagendaPro -e 'SELECT COUNT(*) AS contas FROM cp_agenda_accounts; SELECT COUNT(*) AS agendamentos FROM cp_agenda_appointments; SELECT COUNT(*) AS clientes FROM cp_agenda_clients;'"
expect {
    "password:" {
        send "Creative23SSHcp@\r"
        expect eof
    }
    eof
}

puts "=== 6B: Exportando dump da Hostinger ==="
spawn sh -c "ssh -p 65002 -o StrictHostKeyChecking=no u176367625@46.202.186.144 \"mysqldump -u u176367625_cpagendakt -p'u5RjUpN\$4/rX' --single-transaction --routines --triggers u176367625_CPagendaPro\" > /Users/karlateshima/backup_cpagenda.sql"
expect {
    "password:" {
        send "Creative23SSHcp@\r"
        expect eof
    }
    eof
}

puts "=== Verificando arquivo local ==="
spawn sh -c "ls -lh /Users/karlateshima/backup_cpagenda.sql && wc -l /Users/karlateshima/backup_cpagenda.sql"
expect eof

puts "=== 6C: Enviando dump para VPS ==="
# VPS deploy user requires NO password, uses local SSH key
spawn scp -o StrictHostKeyChecking=no /Users/karlateshima/backup_cpagenda.sql deploy@76.13.209.192:/tmp/backup_cpagenda.sql
expect eof

puts "=== 6C: Restaurando na VPS ==="
spawn ssh -o StrictHostKeyChecking=no deploy@76.13.209.192 "mysql -u cpagenda_user -p'Cp@genda2024!Vps#Secure' cp_agenda_pro < /tmp/backup_cpagenda.sql && echo 'Restauracao concluida'"
expect eof

puts "=== 6D: Verificando integridade na VPS ==="
spawn ssh -o StrictHostKeyChecking=no deploy@76.13.209.192 "mysql -u cpagenda_user -p'Cp@genda2024!Vps#Secure' cp_agenda_pro -e 'SELECT COUNT(*) AS contas FROM cp_agenda_accounts; SELECT COUNT(*) AS agendamentos FROM cp_agenda_appointments; SELECT COUNT(*) AS clientes FROM cp_agenda_clients;'"
expect eof

